# Choose provider: "ollama" (local, default) or "anthropic" (Claude API)
LLM_PROVIDER=ollama

# --- Ollama ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_NUM_CTX=8192

# "multi" = 3 focused calls (accurate with small local models), "single" = 1 call (faster; use with big models/Claude)
LLM_MODE=multi
LLM_KEEP_ALIVE=30m
LLM_NUM_PREDICT=3000

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- App ---
LLM_TIMEOUT=300
MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=20000
LOG_LEVEL=INFO

# --- Streamlit -> API ---
API_URL=http://localhost:8000
